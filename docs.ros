#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf))

(let ((root (uiop:pathname-directory-pathname *load-pathname*)))
  (push root asdf:*central-registry*))

(asdf:load-system :bknr.ttl/docs :verbose nil)

(defun main (&rest argv)
  "Renders bknr.ttl's manual to standard output."
  (declare (ignorable argv))
  (bknr.ttl/docs:generate))
